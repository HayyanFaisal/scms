# Main SCMS API. Copy this file to .env and replace every placeholder.
DATABASE_URL=mysql://scms_app:replace-with-password@127.0.0.1:3306/pnba
PORT=3001

# Browser client. Prefer the same-origin /api path behind the Vite/reverse proxy.
VITE_API_URL=/api
SCMS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Temporary secret used only by the legacy authority portal until it is migrated
# to named staff accounts and RBAC. Generate a long random value.
JWT_SECRET=replace-with-a-long-random-secret
SCMS_ENABLE_LEGACY_AUTHORITY_LOGIN=false

# Session controls
SCMS_SESSION_INACTIVITY_MINUTES=10
SCMS_SESSION_ABSOLUTE_HOURS=8
SCMS_MAX_LOGIN_FAILURES=5
SCMS_ACCOUNT_LOCK_MINUTES=15
SCMS_SECURE_COOKIES=false
SCMS_TRUST_PROXY=false

# Protected local/NAS storage roots. Neither directory may be web-served.
# SCMS_DOCUMENT_STORAGE_DIR=C:\scms-data\documents
# SCMS_IMPORT_STORAGE_DIR=C:\scms-data\imports

# Parent portal bridge (temporary during API consolidation)
PORTAL_API_URL=http://127.0.0.1:4000
PORTAL_API_KEY=replace-with-a-long-random-bridge-key

# Use these only while running `npm run bootstrap:director`, then remove them.
# SCMS_BOOTSTRAP_USERNAME=director
# SCMS_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
# SCMS_BOOTSTRAP_DISPLAY_NAME=SCMS Director
# SCMS_BOOTSTRAP_EMAIL=
