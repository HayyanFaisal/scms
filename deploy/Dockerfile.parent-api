FROM node:22-bookworm-slim
WORKDIR /app/parent-portal
COPY parent-portal/package.json parent-portal/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY parent-portal/server.js ./server.js
COPY server /app/server
ENV NODE_ENV=production PORTAL_HOST=0.0.0.0 PORTAL_PORT=4000
EXPOSE 4000
CMD ["node", "server.js"]

