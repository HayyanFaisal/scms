FROM node:22-bookworm-slim AS admin-build
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html authority.html vite.config.ts tsconfig*.json components.json postcss.config.js tailwind.config.js ./
COPY src ./src
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM node:22-bookworm-slim AS parent-build
WORKDIR /build
COPY parent-portal/client/package.json parent-portal/client/package-lock.json ./
RUN npm ci
COPY parent-portal/client ./
RUN npm run build

FROM caddy:2.10-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=admin-build /build/dist /srv/admin
COPY --from=parent-build /build/dist /srv/parent
EXPOSE 80 443
